{
  "name": "usa-elections-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive JavaScript/D3 dashboard exploring the 2024 US presidential election results and comparing them with the 2026 midterm elections.",
  "scripts": {
    "build-data": "node scripts/build-data.mjs",
    "predev": "npm run build-data",
    "prebuild": "npm run build-data",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "setup": "npm install && npm run build-data"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "xlsx": "^0.18.5"
  }
}
